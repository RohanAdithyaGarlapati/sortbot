<!--
  SortBot scene: a Franka Panda arm, three colored cubes, and three matching pads.

  Units: meters, kilograms, seconds, radians.
  Axes:  +x points away from the robot, +y to the robot's left, +z up.
  The robot's base sits at the origin (0, 0, 0).
-->
<mujoco model="sortbot">
  <include file="panda.xml"/>

  <statistic center="0.45 0 0.2" extent="1.0"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-28" offwidth="1920" offheight="1920"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.08"/>
  </asset>

  <default>
    <!-- 5 cm cubes, 100 g each. High friction plus condim="4" (torsional friction) helps the gripper hold them. -->
    <default class="cube">
      <geom type="box" size="0.025 0.025 0.025" mass="0.1" friction="1.5 0.02 0.001" condim="4" solref="0.01 1"/>
    </default>
    <!-- Pads are flat painted squares on the floor. contype/conaffinity 0 means nothing collides with them. -->
    <default class="pad">
      <geom type="box" size="0.045 0.045 0.0005" contype="0" conaffinity="0"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.4 0 2.2" dir="0 0 -1" diffuse="0.7 0.7 0.7"/>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" diffuse="0.35 0.35 0.35" castshadow="false"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Target pads, lined up on the robot's left side -->
    <geom name="red_pad"   class="pad" pos="0.36 0.32 0.0005" rgba="0.90 0.25 0.25 0.55"/>
    <geom name="green_pad" class="pad" pos="0.50 0.32 0.0005" rgba="0.25 0.80 0.35 0.55"/>
    <geom name="blue_pad"  class="pad" pos="0.64 0.32 0.0005" rgba="0.25 0.45 0.95 0.55"/>

    <!-- Cubes. A freejoint lets a body move and rotate freely, so the robot can pick it up. -->
    <body name="red_cube" pos="0.62 -0.16 0.025">
      <freejoint name="red_cube"/>
      <geom name="red_cube" class="cube" rgba="0.90 0.15 0.15 1"/>
    </body>
    <body name="green_cube" pos="0.40 -0.22 0.025">
      <freejoint name="green_cube"/>
      <geom name="green_cube" class="cube" rgba="0.15 0.75 0.25 1"/>
    </body>
    <body name="blue_cube" pos="0.50 -0.02 0.025">
      <freejoint name="blue_cube"/>
      <geom name="blue_cube" class="cube" rgba="0.15 0.35 0.90 1"/>
    </body>

    <!-- A fixed bird's-eye camera. Videos use an orbiting camera defined in sortbot/video.py. -->
    <camera name="top" pos="0.5 -0.05 1.5" xyaxes="0 -1 0 1 0 0"/>
  </worldbody>
</mujoco>
